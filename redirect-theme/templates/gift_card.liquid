{%- comment -%}
  The gift card email links here (/gift_cards/{token}). The headless app has
  no recipient page, so the card is shown by the theme.
{%- endcomment -%}
{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Gift card · {{ shop.name }}</title>
    {{ content_for_header }}
    <style>
      body { font-family: system-ui, sans-serif; max-width: 26rem; margin: 4rem auto; padding: 0 1rem; color: #111; text-align: center; }
      .code { font-size: 1.5rem; letter-spacing: 0.1em; padding: 1rem; border: 1px dashed #999; border-radius: 8px; }
      a { display: inline-block; margin-top: 1.5rem; padding: 0.7rem 1.2rem; border-radius: 6px; background: #111; color: #fff; text-decoration: none; }
    </style>
  </head>
  <body>
    <h1>{{ shop.name }}</h1>
    {%- if gift_card.enabled == false or gift_card.expired -%}
      <p>This gift card is no longer active.</p>
    {%- endif -%}
    <p>Your {{ gift_card.initial_value | money }} gift card</p>
    <p class="code">{{ gift_card.code | format_code }}</p>
    <p>Balance: {{ gift_card.balance | money }}</p>
    {%- if gift_card.expires_on -%}
      <p>Expires {{ gift_card.expires_on | date: '%B %d, %Y' }}</p>
    {%- endif -%}
    {%- if settings.storefront_url != blank -%}
      <a href="{{ settings.storefront_url | escape }}">Start shopping</a>
    {%- endif -%}
  </body>
</html>
