# ── Shopify ────────────────────────────────────────────────────────────────
# Store domain, e.g. your-store.myshopify.com (no protocol)
SHOPIFY_STORE_DOMAIN=
# Storefront API access token (Headless channel or custom app)
SHOPIFY_STOREFRONT_TOKEN=
# Admin API access token — only needed for scripts/seed.ts and webhook registration
SHOPIFY_ADMIN_TOKEN=
# API version for both Storefront and Admin APIs
SHOPIFY_API_VERSION=2025-07
# Secret used to verify incoming webhook HMAC signatures
SHOPIFY_WEBHOOK_SECRET=
# Default country for @inContext pricing/currency when not derivable from locale
SHOPIFY_DEFAULT_COUNTRY=EG

# ── Customer accounts (domains/customer) ──────────────────────────────────
# Sign-in/register/reset use the classic Storefront API (the storefront token
# above is all Shopify needs). Set this secret to encrypt the session cookie
# and enable the feature; leave empty to show a "not configured" notice.
# Any random string ≥ 32 chars, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# ── App ────────────────────────────────────────────────────────────────────
# Public URL of this storefront (used for canonical URLs and webhook registration)
SITE_URL=http://localhost:3000
# Secret for the manual revalidation escape hatch: POST /api/revalidate
REVALIDATION_SECRET=

# ── Checkout ───────────────────────────────────────────────────────────────
# "redirect" (default) sends the buyer to Shopify's hosted checkout, or
# "embedded" keeps them on-site via Shopify Checkout Kit's <shopify-checkout>
# overlay. Customer prefill/attribution runs through the cart's buyerIdentity
# in both modes — the mode only changes where checkout is displayed.
CHECKOUT_MODE=redirect

# ── Search ─────────────────────────────────────────────────────────────────
# "shopify" (native Predictive Search, default) or "algolia"
SEARCH_PROVIDER=shopify
# Required only when SEARCH_PROVIDER=algolia
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_INDEX=products

# ── Tracking (src/lib/tracking) ────────────────────────────────────────────
# Every vendor is optional — leave an id empty and that vendor no-ops.
# Google Tag Manager container id (GTM-XXXXXXX). Pushes GA4 e-commerce
# events (page_view, view_item, add_to_cart, begin_checkout, purchase, …)
# enriched with 30-day first-touch UTM params.
NEXT_PUBLIC_GTM_ID=
# CleverTap account id + region (e.g. eu1, in1, sg1, us1). SDK loads at idle.
NEXT_PUBLIC_CLEVERTAP_ACCOUNT_ID=
NEXT_PUBLIC_CLEVERTAP_REGION=
# Global kill switch — set to "false" to disable all tracking vendors.
NEXT_PUBLIC_ENABLE_TRACKING=
# Algolia Insights (search click/conversion analytics) needs no variables:
# it activates with SEARCH_PROVIDER=algolia, relayed via /api/search/events.
